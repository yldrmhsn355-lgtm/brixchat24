APP_ENV=staging
NODE_ENV=production
APP_VERSION=0.1.0-rc.1
GIT_COMMIT_SHA=replace-at-build
BUILD_TIME=replace-at-build
# API-only: WEB_PUBLIC_URL, WEBHOOK_PUBLIC_URL and CORS_ALLOWED_ORIGINS.
# Shared by API and worker: API_PUBLIC_URL.
WEB_PUBLIC_URL=https://app.staging.brixchat.example
API_PUBLIC_URL=https://api.staging.brixchat.example
WEBHOOK_PUBLIC_URL=https://webhooks.staging.brixchat.example
CORS_ALLOWED_ORIGINS=https://app.staging.brixchat.example
# These public URLs are compiled into the web image. Set them before the build.
NEXT_PUBLIC_API_URL=https://api.staging.brixchat.example
NEXT_PUBLIC_REALTIME_URL=https://api.staging.brixchat.example/api/v1/realtime
# Leave forwarded client IPs untrusted until the staging proxy path is verified.
TRUST_PROXY=false
COOKIE_DOMAIN=.staging.brixchat.example
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
DATABASE_URL=postgresql://user:password@staging-db:5432/brixchat?sslmode=require
API_DATABASE_POOL_MAX=10
WORKER_DATABASE_POOL_MAX=5
WORKER_HEALTH_PORT=4100
REDIS_URL=rediss://staging-redis:6380
REDIS_PRIVATE_NETWORK=false
# API-only authentication secrets. The worker does not need them.
JWT_ACCESS_SECRET=required-from-secret-provider
JWT_REFRESH_SECRET=required-from-secret-provider
# Shared by API and worker; keep the same value across both services.
APP_ENCRYPTION_KEY=required-from-secret-provider
# API-only email delivery configuration.
EMAIL_PROVIDER=smtp
MESSAGING_PROVIDER_MODE=meta
# Enable only on a stable worker after QR/restart/inbound acceptance.
WHATSAPP_WEB_ENABLED=false
CRM_PROVIDER_MODE=bitrix24
OBJECT_STORAGE_PROVIDER=s3
MALWARE_SCANNER_PROVIDER=clamav
S3_BUCKET_PUBLIC=false
# API-only observability, webhook verification and operations-route secrets.
METRICS_API_KEY=required-from-secret-provider
META_WHATSAPP_APP_SECRET=required-from-secret-provider
META_WHATSAPP_VERIFY_TOKEN=required-from-secret-provider
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api-staging.example.com/api/v1/integrations/google-drive/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=required-from-secret-provider
BITRIX24_WEBHOOK_TOKEN=required-from-secret-provider
INTERNAL_OPERATIONS_TOKEN=required-from-secret-provider
LOG_LEVEL=info
ALLOW_DEVELOPMENT_ADMIN=false
