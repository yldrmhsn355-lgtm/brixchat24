# Load only inside an authorized staging/production acceptance runner.
# Never commit the populated .env.acceptance.local file.
ACCEPTANCE_ENVIRONMENT=staging
ACCEPTANCE_COMMIT_SHA=replace-with-deployed-version-commit
ACCEPTANCE_EVIDENCE_SIGNING_KEY=required-random-at-least-32-characters
EXTERNAL_ACCEPTANCE_TIMEOUT_MS=15000
ACCEPTANCE_POLL_TIMEOUT_MS=120000
ACCEPTANCE_POLL_INTERVAL_MS=2000

META_WHATSAPP_API_VERSION=v25.0
# Prefer DATABASE_URL + APP_ENCRYPTION_KEY to resolve the encrypted channel.
# Set this selector only when more than one connected Meta channel exists.
META_ACCEPTANCE_CHANNEL_PUBLIC_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_ACCEPTANCE_EXPECTED_CALLBACK_URI=https://api.brixchat.example/webhooks/meta/channel-id
META_ACCEPTANCE_TEST_PHONE=consented-test-recipient
META_ACCEPTANCE_CONFIRM=
META_ACCEPTANCE_INBOUND_MARKER=replace-with-a-unique-test-marker
META_ACCEPTANCE_TEMPLATE_NAME=
META_ACCEPTANCE_TEMPLATE_LANGUAGE=tr
META_ACCEPTANCE_TEMPLATE_VARIABLES=
META_ACCEPTANCE_MEDIA_URL=
META_ACCEPTANCE_MEDIA_TYPE=image
DATABASE_URL=required-read-only-acceptance-database-url
APP_ENCRYPTION_KEY=required-to-resolve-encrypted-provider-credentials

# Prefer the encrypted connected DB record. Set the selector only when multiple
# connected Bitrix24 records exist. Direct credentials remain a fallback.
BITRIX24_ACCEPTANCE_CONNECTION_PUBLIC_ID=
BITRIX24_WEBHOOK_URL=
BITRIX24_ACCEPTANCE_PORTAL_URL=
BITRIX24_ACCESS_TOKEN=
BITRIX24_ACCEPTANCE_ENTITY_TYPE=contact
BITRIX24_ACCEPTANCE_ENTITY_ID=
BITRIX24_ACCEPTANCE_CONFIRM=
BITRIX24_ACCEPTANCE_TEST_USER_ID=
BITRIX24_ACCEPTANCE_ORIGINAL_USER_ID=

OBJECT_STORAGE_PROVIDER=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
STORAGE_ACCEPTANCE_CONFIRM=

MALWARE_SCANNER_PROVIDER=clamav
CLAMAV_HOST=
CLAMAV_PORT=3310
CLAMAV_HEALTHCHECK_TIMEOUT_MS=2000
CLAMAV_SCAN_TIMEOUT_MS=30000
MALWARE_ACCEPTANCE_CONFIRM=

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
SMTP_ACCEPTANCE_RECIPIENT=
SMTP_ACCEPTANCE_CONFIRM=
