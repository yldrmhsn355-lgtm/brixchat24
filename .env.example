NODE_ENV=development
COMPOSE_PROJECT_NAME=brixchat24-live
DATABASE_URL=postgresql://brixchat:brixchat@localhost:5434/brixchat
REDIS_URL=redis://localhost:6381

JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

APP_ENCRYPTION_KEY=replace-with-32-byte-base64-key
APP_PUBLIC_URL=http://localhost:3300
WEB_PUBLIC_URL=http://localhost:3300
API_PUBLIC_URL=http://localhost:4400

# Disabled by default. Use only an explicit trusted proxy hop count or
# comma-separated address/CIDR allow-list; blanket `true` is rejected.
TRUST_PROXY=false
# Railway injects PORT. Local/container workers keep this 4100 fallback.
WORKER_HEALTH_PORT=4100

COOKIE_DOMAIN=
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

EMAIL_PROVIDER=console
EMAIL_FROM=no-reply@example.test
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=

MESSAGING_PROVIDER_MODE=fake
# Starts the separate long-lived Baileys linked-device runtime.
WHATSAPP_WEB_ENABLED=false
FAKE_PROVIDER_MODE=success
META_WHATSAPP_API_VERSION=v25.0
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_BUSINESS_ACCOUNT_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_APP_SECRET=
META_WHATSAPP_VERIFY_TOKEN=

GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4400/api/v1/integrations/google-drive/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=

# Bitrix24 OAuth is optional. Incoming webhook and fake mode do not require these.
BITRIX24_CLIENT_ID=
BITRIX24_CLIENT_SECRET=
BITRIX24_FAKE_SCENARIO=success
BITRIX24_WEBHOOK_TOKEN=

NEXT_PUBLIC_API_URL=http://localhost:4400
NEXT_PUBLIC_REALTIME_URL=http://localhost:4400/api/v1/realtime
# Optional login-form prefill for local development only. Production ignores it.
NEXT_PUBLIC_DEMO_LOGIN_EMAIL=owner@brixchat.local
NEXT_PUBLIC_DEMO_LOGIN_PASSWORD=BrixChatDemo!2026
SIMULATOR_CHANNEL_PUBLIC_ID=00000000-0000-4000-8000-000000000022

OBJECT_STORAGE_PROVIDER=local
OBJECT_STORAGE_LOCAL_PATH=.data/media
# Explicit single-server production option: filesystem + clamav.
# Provision this private absolute directory outside the IIS web root first.
OBJECT_STORAGE_FILESYSTEM_ROOT=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false
S3_PUBLIC_BASE_URL=
MALWARE_SCANNER_PROVIDER=noop
CLAMAV_HOST=
CLAMAV_PORT=3310
MEDIA_MAX_IMAGE_BYTES=10000000
MEDIA_MAX_VIDEO_BYTES=50000000
MEDIA_MAX_AUDIO_BYTES=20000000
MEDIA_MAX_DOCUMENT_BYTES=25000000
MEDIA_SIGNED_URL_TTL_SECONDS=300
AUTOMATION_WORKER_CONCURRENCY=2
AUTOMATION_MAX_STEPS=100
AUTOMATION_MAX_LOOP_ITERATIONS=20
AUTOMATION_MAX_EXECUTION_DURATION=3600000
AUTOMATION_MAX_SUBFLOW_DEPTH=5
AUTOMATION_DEFAULT_RETRY_LIMIT=5
AUTOMATION_STALE_EXECUTION_MINUTES=5
AUTOMATION_STALE_LOCK_SECONDS=120
AUTOMATION_EVENT_RETENTION_DAYS=90
AUTOMATION_LOG_RETENTION_DAYS=30
AUTOMATION_WEBHOOK_TIMEOUT_MS=10000
AUTOMATION_MAX_DEPTH=5
AUTOMATION_MAX_ACTIONS_PER_RUN=20
AUTOMATION_WEBHOOK_ALLOWED_HOSTS=
BITRIX24_OPEN_CHANNELS_ENABLED=false
RETENTION_WORKER_ENABLED=false
DEFAULT_MESSAGE_RETENTION_DAYS=365
DEFAULT_MEDIA_RETENTION_DAYS=180
DEFAULT_WEBHOOK_RETENTION_DAYS=30
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_ENABLED=true
METRICS_API_KEY=replace-with-internal-metrics-key

# Subscription billing (Paddle sandbox by default). Keep API key and webhook
# secret server-side; the client token is intentionally publishable.
PADDLE_ENVIRONMENT=sandbox
PADDLE_API_KEY=
PADDLE_CLIENT_TOKEN=
PADDLE_WEBHOOK_SECRET=
PADDLE_CHECKOUT_URL=http://localhost:3300/app/billing
BILLING_GRACE_DAYS=7

# AI Agent Platform (OpenRouter)
# Master switch for the AI orchestration loop and AI API routes.
AI_ENABLED=false
# Server-side only; never exposed to the browser. Workspaces may override
# with their own encrypted key via AI settings.
OPENROUTER_API_KEY=
# Optional _FILE variant is supported: OPENROUTER_API_KEY_FILE=/run/secrets/openrouter
# Fallback model chain when the agent/workspace does not configure one.
AI_DEFAULT_MODEL=
AI_FALLBACK_MODEL=
# Embedding model for knowledge retrieval (empty = lexical-only retrieval;
# "local/hash-256" = deterministic offline embeddings for dev/test).
AI_EMBEDDING_MODEL=
# Parallel AI runs in the worker (1-8).
AI_WORKER_CONCURRENCY=2
