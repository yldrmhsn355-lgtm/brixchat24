<?xml version="1.0" encoding="utf-8"?>
<configuration><system.webServer>
  <directoryBrowse enabled="false" />
  <security><requestFiltering><requestLimits maxAllowedContentLength="31457280" /></requestFiltering></security>
  <rewrite><rules>
    <rule name="ACME" stopProcessing="true"><match url="^\.well-known/acme-challenge/" /><action type="None" /></rule>
    <rule name="HTTPS" stopProcessing="true"><match url="(.*)" /><conditions><add input="{HTTPS}" pattern="off" /></conditions><action type="Redirect" url="https://api.brixchat24.com/{R:1}" redirectType="Permanent" /></rule>
    <rule name="API" stopProcessing="true"><match url="(.*)" /><action type="Rewrite" url="http://127.0.0.1:4410/{R:1}" /></rule>
  </rules></rewrite>
  <httpErrors existingResponse="PassThrough" />
  <urlCompression doStaticCompression="false" doDynamicCompression="false" />
  <httpProtocol><customHeaders>
    <add name="Strict-Transport-Security" value="max-age=31536000" />
    <add name="X-Content-Type-Options" value="nosniff" />
    <add name="X-Frame-Options" value="DENY" />
    <add name="Referrer-Policy" value="strict-origin-when-cross-origin" />
    <add name="Content-Security-Policy" value="default-src 'none'; frame-ancestors 'none'" />
  </customHeaders></httpProtocol>
</system.webServer></configuration>
