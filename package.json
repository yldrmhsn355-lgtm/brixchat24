{
  "name": "brixchat24",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "turbo dev --parallel",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "pnpm typecheck:release-tooling && turbo typecheck",
    "typecheck:release-tooling": "tsc -p scripts/tsconfig.json --noEmit",
    "test": "pnpm test:release-tooling && turbo test",
    "test:release-tooling": "vitest run scripts/acceptance-report.test.ts scripts/acceptance-probes.test.ts scripts/release-gate.test.ts scripts/production-release-config.test.ts scripts/docker-stack.test.ts",
    "architecture:check": "pnpm architecture:graph:check && pnpm architecture:database:check",
    "architecture:graph:update": "graphify update . --force",
    "architecture:graph:check": "node scripts/check-graph-analysis-inputs.mjs",
    "architecture:database:check": "node scripts/check-database-boundaries.mjs",
    "docker:doctor": "node scripts/docker-stack.mjs doctor",
    "docker:up:infra": "node scripts/docker-stack.mjs up -d postgres redis",
    "docker:up": "node scripts/docker-stack.mjs up -d --build",
    "docker:down": "node scripts/docker-stack.mjs down --remove-orphans",
    "docker:ps": "node scripts/docker-stack.mjs ps",
    "docker:logs": "node scripts/docker-stack.mjs logs --tail=200",
    "db:generate": "pnpm --filter @brixchat/database db:generate",
    "db:migrate": "pnpm --filter @brixchat/database db:migrate",
    "db:seed": "pnpm --filter @brixchat/database db:seed",
    "db:migrate:check": "tsx scripts/migration-safety.ts check",
    "db:migrate:production": "tsx scripts/migration-safety.ts production",
    "whatsapp-web:preflight": "tsx scripts/whatsapp-web-preflight.ts",
    "audit:crm-identities": "tsx scripts/crm-identity-preflight.ts",
    "db:seed:performance": "tsx scripts/performance-seed.ts",
    "webhook:simulate:incoming": "tsx scripts/webhook-simulator.ts incoming",
    "webhook:simulate:status": "tsx scripts/webhook-simulator.ts status",
    "webhook:simulate:fields": "tsx scripts/webhook-simulator.ts fields",
    "webhook:simulate:unsubscribed": "tsx scripts/webhook-simulator.ts unsubscribed-fields",
    "webhook:test:fields:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/webhook-fields-e2e.ps1",
    "channel:credentials:set": "tsx scripts/channel-credentials.ts",
    "acceptance:meta:verify": "tsx scripts/external-acceptance.ts meta verify",
    "acceptance:meta:send-text": "tsx scripts/external-acceptance.ts meta send-text",
    "acceptance:meta:send-template": "tsx scripts/external-acceptance.ts meta send-template",
    "acceptance:meta:send-media": "tsx scripts/external-acceptance.ts meta send-media",
    "acceptance:meta:wait-status": "tsx scripts/external-acceptance.ts meta wait-status",
    "acceptance:meta:wait-inbound": "tsx scripts/external-acceptance.ts meta wait-inbound",
    "acceptance:meta:report": "tsx scripts/external-acceptance.ts meta report",
    "acceptance:bitrix:health": "tsx scripts/external-acceptance.ts bitrix health",
    "acceptance:bitrix:crm-context": "tsx scripts/external-acceptance.ts bitrix crm-context",
    "acceptance:bitrix:timeline": "tsx scripts/external-acceptance.ts bitrix timeline",
    "acceptance:bitrix:assignment": "tsx scripts/external-acceptance.ts bitrix assignment",
    "acceptance:bitrix:open-channels": "tsx scripts/external-acceptance.ts bitrix open-channels",
    "acceptance:bitrix:report": "tsx scripts/external-acceptance.ts bitrix report",
    "acceptance:storage": "tsx scripts/external-acceptance.ts storage all",
    "acceptance:malware": "tsx scripts/external-acceptance.ts malware all",
    "acceptance:smtp:verify": "tsx scripts/external-acceptance.ts smtp verify",
    "acceptance:smtp": "tsx scripts/external-acceptance.ts smtp all",
    "security:audit": "tsx scripts/security-tooling.ts audit",
    "security:sbom": "tsx scripts/security-tooling.ts sbom",
    "security:licenses": "tsx scripts/security-tooling.ts licenses",
    "security:containers": "tsx scripts/security-tooling.ts containers",
    "security:scan:staging": "tsx scripts/security-tooling.ts staging-scan",
    "security:secrets": "tsx scripts/security-tooling.ts secrets",
    "security:rbac": "tsx scripts/security-verification.ts rbac",
    "security:tenant-isolation": "tsx scripts/security-verification.ts tenant-isolation",
    "recovery:backup-restore": "tsx scripts/backup-restore-test.ts",
    "recovery:backup-restore:production": "tsx scripts/backup-restore-test.ts",
    "load:test:smoke": "tsx scripts/load-test.ts smoke",
    "load:test:standard": "tsx scripts/load-test.ts standard",
    "smoke:test": "tsx scripts/smoke-test.ts",
    "release:gate": "tsx scripts/release-gate.ts",
    "tenant:create": "tsx scripts/tenant-cli.ts create",
    "tenant:list": "tsx scripts/tenant-cli.ts list",
    "tenant:disable": "tsx scripts/tenant-cli.ts disable",
    "tenant:enable": "tsx scripts/tenant-cli.ts enable",
    "tenant:assign-plan": "tsx scripts/tenant-cli.ts assign-plan",
    "tenant:usage": "tsx scripts/tenant-cli.ts usage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.19.19",
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.9",
    "prettier": "^3.9.5",
    "tsx": "^4.20.5",
    "turbo": "^2.5.6",
    "typescript": "^7.0.2",
    "vitest": "^3.2.4"
  }
}
