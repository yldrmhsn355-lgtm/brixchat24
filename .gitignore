# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/.vinext/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.staging.example
!.env.production.example
!.env.acceptance.example
!**/.env.example

# monorepo outputs
**/.next/
**/.next*/
**/dist/
**/build/
**/coverage/
**/.turbo/
**/tmp/
**/generated/
*.min.js
*.bundle.js
.turbo/

# local tooling and generated architecture artifacts
/.codex/
/graphify-out/
/.openai/

# local runtime data
/.data/
**/.data/
/.backups/

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo
/dist/
/.wrangler/
/outputs/
/work/
/artifacts/
