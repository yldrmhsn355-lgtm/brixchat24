APP_ENV=production
NODE_ENV=production
APP_VERSION=1.0.0
GIT_COMMIT_SHA=replace-at-build
BUILD_TIME=replace-at-build
# API-only: WEB_PUBLIC_URL, WEBHOOK_PUBLIC_URL and CORS_ALLOWED_ORIGINS.
# Shared by API and worker: API_PUBLIC_URL.
WEB_PUBLIC_URL=https://app.brixchat.example
API_PUBLIC_URL=https://api.brixchat.example
WEBHOOK_PUBLIC_URL=https://webhooks.brixchat.example
CORS_ALLOWED_ORIGINS=https://app.brixchat.example
# These public URLs are compiled into the web image. Set them before the build.
NEXT_PUBLIC_API_URL=https://api.brixchat.example
NEXT_PUBLIC_REALTIME_URL=https://api.brixchat.example/api/v1/realtime
# Railway + Cloudflare is two verified proxy hops. Keep the Railway-generated
# public domain disabled before using this count; `true` is intentionally rejected.
TRUST_PROXY=2
COOKIE_DOMAIN=.brixchat.example
COOKIE_SECURE=true
COOKIE_SAME_SITE=lax
# Use separate env files in production. The API file contains only the scoped
# API credential; the worker file contains only the cross-tenant worker
# credential. DATABASE_URL is reserved for migration/admin tooling.
API_DATABASE_URL=postgresql://brixchat_app_scoped:password@managed-postgres:5432/brixchat?sslmode=verify-full
WORKER_DATABASE_URL=postgresql://worker_owner:password@managed-postgres:5432/brixchat?sslmode=verify-full
DATABASE_URL=postgresql://migration_owner:password@managed-postgres:5432/brixchat?sslmode=verify-full
REQUIRE_SERVICE_DATABASE_URLS=true
API_DATABASE_POOL_MAX=20
WORKER_DATABASE_POOL_MAX=8
WORKER_HEALTH_PORT=4100
REDIS_URL=rediss://managed-redis:6380
REDIS_PRIVATE_NETWORK=false
DISTRIBUTED_RATE_LIMIT_ENABLED=true
REQUIRE_DISTRIBUTED_RATE_LIMIT=true
OPENAPI_ENABLED=true
# API-only authentication secrets. The worker does not need them.
JWT_ACCESS_SECRET=required-from-secret-provider
JWT_REFRESH_SECRET=required-from-secret-provider
# Shared by API and worker; keep the same value across both services.
APP_ENCRYPTION_KEY=required-from-secret-provider
# API-only email delivery configuration.
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@brixchat.example
SMTP_HOST=required-from-secret-provider
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USERNAME=required-from-secret-provider
SMTP_PASSWORD=required-from-secret-provider
MESSAGING_PROVIDER_MODE=meta
# This is not Meta Cloud API. Keep false until a stable worker and live
# linked-device acceptance (auth keys, restart persistence, inbound/outbound)
# are proven.
WHATSAPP_WEB_ENABLED=false
CRM_PROVIDER_MODE=bitrix24
OBJECT_STORAGE_PROVIDER=s3
MALWARE_SCANNER_PROVIDER=clamav
S3_BUCKET=private-brixchat-media
S3_REGION=us-east-1
S3_ENDPOINT=
S3_ACCESS_KEY_ID=required-from-secret-provider
S3_SECRET_ACCESS_KEY=required-from-secret-provider
S3_FORCE_PATH_STYLE=false
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_HEALTHCHECK_TIMEOUT_MS=2000
CLAMAV_SCAN_TIMEOUT_MS=30000
S3_BUCKET_PUBLIC=false
# API-only observability, webhook verification and operations-route secrets.
METRICS_API_KEY=required-from-secret-provider
META_WHATSAPP_APP_SECRET=required-from-secret-provider
META_WHATSAPP_VERIFY_TOKEN=required-from-secret-provider
GOOGLE_DRIVE_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=https://api.example.com/api/v1/integrations/google-drive/callback
GOOGLE_TOKEN_ENCRYPTION_KEY=required-from-secret-provider
BITRIX24_WEBHOOK_TOKEN=required-from-secret-provider
INTERNAL_OPERATIONS_TOKEN=required-from-secret-provider
PADDLE_ENVIRONMENT=production
PADDLE_API_KEY=required-from-secret-provider
PADDLE_CLIENT_TOKEN=required-public-client-token
PADDLE_WEBHOOK_SECRET=required-from-secret-provider
PADDLE_CHECKOUT_URL=https://app.brixchat.example/app/billing
BILLING_GRACE_DAYS=7
LOG_LEVEL=info
ALLOW_DEVELOPMENT_ADMIN=false

# AI Agent Platform (OpenRouter)
AI_ENABLED=false
OPENROUTER_API_KEY=required-from-secret-provider-when-ai-enabled
AI_DEFAULT_MODEL=
AI_FALLBACK_MODEL=
AI_EMBEDDING_MODEL=
AI_WORKER_CONCURRENCY=2
